# PostgreSQL
DATABASE_NAME=selleros
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email OTP delivery (use an SMTP backend in production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=selleros005@gmail.com
EMAIL_HOST_PASSWORD=vdsn emvs eimx skmb
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# SMS OTP delivery (Twilio). Phone numbers must be in E.164 format, e.g. +917719747876.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP policy
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
